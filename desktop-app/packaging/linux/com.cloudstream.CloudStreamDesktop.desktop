[Desktop Entry]
Type=Application
Name=CloudStream Desktop
Comment=CloudStream desktop media client
Exec=cloudstream %U
Icon=com.cloudstream.CloudStreamDesktop
Terminal=false
Categories=AudioVideo;Video;Player;
StartupNotify=true
